{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/tables", "destination": "/api/tables.js" },
    { "source": "/api/menu", "destination": "/api/menu.js" },
    { "source": "/api/orders", "destination": "/api/orders.js" },
    { "source": "/api/signing/(.*)", "destination": "/api/signing.js" },
    { "source": "/api/sync/(.*)", "destination": "/api/sync.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
