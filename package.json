{
  "name": "restaurant-pos",
  "productName": "Restaurant POS",
  "version": "1.6.7",
  "description": "Restaurant POS Desktop App",
  "author": "Tyde Cafe",
  "private": true,
  "type": "module",
  "main": "electron/entry.cjs",
  "scripts": {
    "dev": "vite --host --port 5175",
    "server": "PORT=3101 node server/index.js",
    "dev:all": "concurrently \"vite --host --port 5175\" \"PORT=3101 node server/index.js\"",
    "build": "vite build && npm --prefix frontend/captain run build && npm --prefix frontend/kitchen run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop": "electron .",
    "pack": "electron-builder --dir",
    "dist": "node scripts/copy-node.js && electron-builder && bash scripts/create-dmg.sh"
  },
  "build": {
    "appId": "com.tydepos.app",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "data/**/*",
      "public/**/*",
      "frontend/captain/dist/**/*",
      "frontend/kitchen/dist/**/*",
      "package.json",
      "scripts/copy-node.js",
      "bundled-node-mac"
    ],
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.business",
      "type": "distribution",
      "artifactName": "Restaurant-POS-v${version}-Installer.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "highestAvailable",
      "artifactName": "Restaurant-POS-v${version}-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Restaurant POS"
    },
    "dmg": {
      "format": "UDZO",
      "background": "build/background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "extraResources": [
      "data/pos_orders.db"
    ]
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^4.21.2",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.474.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "react-router-dom": "^7.1.3",
    "recharts": "^3.8.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^2.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^31.7.7",
    "electron-builder": "^26.8.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  }
}
